{
  "_rule": "passes 以外のフィールドは変更しない。通らないからといって期待値を消したり弱めたりしない。",
  "cases": {
    "calc": {
      "targets": [
        "fixtures/calc/lib/calculations.ts",
        "fixtures/calc/lib/__tests__/calculations.test.ts"
      ],
      "expected": [
        {
          "id": "calc-header-vs-impl",
          "min_severity": "must",
          "desc": "ヘッダーの「平均买入价」と実装（買入総額−売却代金を残数量で割る）が食い違う",
          "passes": true
        },
        {
          "id": "calc-sell-cost-name",
          "min_severity": "should",
          "desc": "totalSellCost は実際には売却代金（proceeds）であり名前が合わない",
          "passes": true
        },
        {
          "id": "calc-repeated-reduce",
          "min_severity": "should",
          "desc": "買い・売りで同じ filter+reduce が 4 回重複している",
          "passes": true
        },
        {
          "id": "calc-numbered-comments",
          "min_severity": "optional",
          "desc": "1〜4 の手順コメントがコードの言い換えにすぎない",
          "passes": false
        },
        {
          "id": "calc-test-title-contradiction",
          "min_severity": "must",
          "desc": "テスト名「卖出价格不影响均价计算」が実装・別テストと矛盾し、売却数量 0 のため偶然通っている",
          "passes": true
        }
      ]
    },
    "chart-hook": {
      "targets": [
        "fixtures/chart-hook/hooks/use-portfolio-candlestick-chart.ts"
      ],
      "context": [
        "fixtures/chart-hook/lib/date-utils.ts"
      ],
      "expected": [
        {
          "id": "hook-unstable-deps",
          "min_severity": "should",
          "desc": "chartData が毎レンダリング新しい配列になり、useEffect 依存で毎回チャートが再作成される",
          "passes": true
        },
        {
          "id": "hook-dead-branch-and-refs",
          "min_severity": "should",
          "desc": "cleanup で null にしているため到達しない旧チャート破棄分岐と、読まれない chartRef/seriesRef",
          "passes": true
        },
        {
          "id": "hook-get-naming",
          "min_severity": "optional",
          "desc": "getFromDate は純粋なローカル計算なので get ではなく compute 系にすべき",
          "passes": true
        },
        {
          "id": "hook-duplicate-price-scale",
          "min_severity": "optional",
          "desc": "priceScale().applyOptions が 2 分岐で同一内容を重複",
          "passes": true
        },
        {
          "id": "hook-return-pct-expression",
          "min_severity": "optional",
          "desc": "収益率の三項演算子+parseFloat+toFixed の入れ子式",
          "passes": true
        }
      ]
    },
    "clean-route": {
      "targets": [
        "fixtures/clean-route/route.ts"
      ],
      "expected": [],
      "forbidden": "must / should の指摘が 1 件でもあれば失敗（信頼境界での検証を不要な防御として指摘するのは誤検出）",
      "passes": true
    },
    "order-summary": {
      "targets": [
        "fixtures/order-summary/order-summary.ts",
        "fixtures/order-summary/order-summary.test.ts"
      ],
      "source": "合成（Claude 作成、作者の確認待ち）",
      "expected": [
        {
          "id": "order-type-bypass",
          "min_severity": "should",
          "desc": "raw as any as Order[] が外部データの検証を飛ばしている",
          "passes": false
        },
        {
          "id": "order-nonnull",
          "min_severity": "should",
          "desc": "省略可能な email に ! を付け、存在するかのように読ませている",
          "passes": false
        },
        {
          "id": "order-mixed-loop",
          "min_severity": "should",
          "desc": "ループ内で絞り込み・集計・整形・通知が同時に進んでいる",
          "passes": false
        },
        {
          "id": "order-hollow-test",
          "min_severity": "should",
          "desc": "テスト名は合計を語るが toBeDefined しか検証せず、計算が壊れていても通る",
          "passes": false
        }
      ]
    },
    "clean-test": {
      "targets": [
        "fixtures/clean-test/price.ts",
        "fixtures/clean-test/price.test.ts"
      ],
      "source": "合成（Claude 作成、作者の確認待ち）",
      "expected": [],
      "forbidden": "must / should の指摘が 1 件でもあれば失敗（beforeEach の let やテスト本体向けでない規則の誤適用は誤検出）",
      "passes": false
    },
    "rereview": {
      "targets": [
        "fixtures/rereview/discount.ts"
      ],
      "context": [
        "fixtures/rereview/previous-report.md"
      ],
      "source": "合成（Claude 作成、作者の確認待ち）",
      "expected": [],
      "forbidden": "解決済みの calc の指摘、見送り済みの calcShip の指摘、差分外の formatYen の指摘のいずれかが出たら失敗",
      "passes": false
    }
  }
}
